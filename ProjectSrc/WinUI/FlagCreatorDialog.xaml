<ContentDialog
    x:Class="RobloxStudioModManager.WinUI.FlagCreatorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Custom Flag"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" Width="320">
        <StackPanel Spacing="4">
            <TextBlock Text="Name:" />
            <TextBox x:Name="FlagNameBox" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Class:" />
            <ComboBox x:Name="FlagClassBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Fast (F)" />
                <ComboBoxItem Content="Dynamic Fast (DF)" />
                <ComboBoxItem Content="Synchronized Fast (SF)" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Type:" />
            <ComboBox x:Name="FlagTypeBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Flag" />
                <ComboBoxItem Content="Int" />
                <ComboBoxItem Content="Log" />
                <ComboBoxItem Content="String" />
            </ComboBox>
        </StackPanel>

        <TextBlock
            x:Name="ErrorText"
            Foreground="Red"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
