<Window
    x:Class="RobloxStudioModManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid Padding="16,16,16,0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: logo + title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                <Image Source="/Assets/Logo.png" Width="96" Height="96" Stretch="Uniform" VerticalAlignment="Center" />

                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Roblox Studio" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" />
                    <TextBlock Text="Mod Manager" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" Margin="0,-8,0,0" />
                    <TextBlock x:Name="ReleaseTagText" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Body: actions on the left, fields/options on the right -->
            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TargetVersionLabel" Text="Target Version:" />

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                    <Button
                        x:Name="LaunchStudioButton"
                        Content="Launch Studio"
                        Click="LaunchStudioButton_Click"
                        HorizontalAlignment="Stretch"
                        FontWeight="Bold" />

                    <Button
                        x:Name="ManageModsButton"
                        Content="Open Mod Folder"
                        Click="ManageModsButton_Click"
                        HorizontalAlignment="Stretch" />

                    <Button
                        x:Name="EditFlagsButton"
                        Content="Edit Fast Flags"
                        Click="EditFlagsButton_Click"
                        HorizontalAlignment="Stretch" />

                    <CheckBox x:Name="OpenStudioDirectoryCheck" Content="Open Working Directory" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0,0,0" />
                    <CheckBox x:Name="ForceRebuildCheck" Content="Force Reinstallation" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <ComboBox
                        x:Name="TargetVersionBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="TargetVersionBox_SelectionChanged" />

                    <TextBlock Text="Channel Name:" Margin="0,8,0,0" />
                    <TextBox x:Name="ChannelNameBox" Text="LIVE" />

                    <TextBlock Text="Channel Access Token:" Margin="0,8,0,0" />
                    <PasswordBox x:Name="ChannelTokenBox" LostFocus="ChannelTokenBox_LostFocus" />
                </StackPanel>
            </Grid>
        </Grid>

        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48" />
    </Grid>
</Window>
